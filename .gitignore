```gitignore
# Dependencies
node_modules/
npm/node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Coverage and testing
coverage/

# Build output
dist/
build/

# Cache
.cache/
.parcel-cache/
.npm/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor settings
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
```
